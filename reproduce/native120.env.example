# Copy to reproduce/.env and edit for the host's available CPU ids.
RUNNER_IMAGE=ubuntu@sha256:353675e2a41babd526e2b837d7ec780c2a05bca0164f7ea5dbbd433d21d166fc
QDRANT_BINARY_PATH=/absolute/path/to/qdrant-native-v1.20.0
HOST_CA_CERT_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Each Qdrant container receives three host CPUs. The external shim pins the
# main thread to the two support CPUs and named search workers to compute CPU.
NODE0_CPUSET=4,5,6
NODE0_SUPPORT_CPUS=5,6
NODE0_COMPUTE_CPU=4
NODE1_CPUSET=7,8,9
NODE1_SUPPORT_CPUS=8,9
NODE1_COMPUTE_CPU=7
NODE2_CPUSET=10,11,12
NODE2_SUPPORT_CPUS=11,12
NODE2_COMPUTE_CPU=10

NODE0_HTTP_HOST_PORT=6333
NODE1_HTTP_HOST_PORT=6334
NODE2_HTTP_HOST_PORT=6335
