# Safe local benchmark settings. No API keys or private credentials belong here.
# Download and extract release tag v1.20.0-veortex.v45.20261109 first. Set this
# to its bin/qdrant executable, whose SHA-256 must be:
# 9a44f09da70af7921da7b2a6893b98c1ea3d9dcab61986d3504b63f4e3dfa0e8.
RUNNER_IMAGE=ubuntu@sha256:353675e2a41babd526e2b837d7ec780c2a05bca0164f7ea5dbbd433d21d166fc
QDRANT_BINARY_PATH=/absolute/path/to/extracted/bin/qdrant
HOST_CA_CERT_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Each node receives three CPUs: one compute CPU and two support CPUs.
NODE0_CPUSET=4,5,6
NODE0_COMPUTE_CPU=4
NODE0_SUPPORT_CPUS=5,6
NODE1_CPUSET=7,8,9
NODE1_COMPUTE_CPU=7
NODE1_SUPPORT_CPUS=8,9
NODE2_CPUSET=10,11,12
NODE2_COMPUTE_CPU=10
NODE2_SUPPORT_CPUS=11,12

NODE0_HTTP_HOST_PORT=6333
NODE1_HTTP_HOST_PORT=6334
NODE2_HTTP_HOST_PORT=6335
