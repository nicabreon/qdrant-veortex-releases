# Admission-budget candidate node0 environment; edit CPU IDs for this host.
# Requires the separately pinned v45.1 admission-budget binary, not original V45.
# The configurable ceiling is 2 GiB; this profile uses 640 MiB, and the unset default stays 384 MiB.
# Read as a systemd EnvironmentFile, or source with set -a in a shell.
# Set before startup. No API/TLS credentials belong in this public example.
QDRANT_VEORTEX_COALESCE_WINDOW_US=1000
QDRANT_VEORTEX_COMPUTE_CPUS=4
QDRANT_VEORTEX_COOPERATIVE_F32=1
QDRANT_VEORTEX_DENSE_MASKED_SCORE=1
QDRANT_VEORTEX_MAX_RING_WORKERS=1
QDRANT_VEORTEX_PAYLOAD_BYTE_CACHE_BYTES=134217728
QDRANT_VEORTEX_RAW_PAYLOAD_TRANSPORT=1
QDRANT_VEORTEX_REST_RAW_VALIDATION_CACHE_BYTES=134217728
QDRANT_VEORTEX_RING_MAX_LANES=96
QDRANT_VEORTEX_SEPARATE_TOPK=1
QDRANT_VEORTEX_SINGLETON_ADMISSION_PERMITS=160
QDRANT_VEORTEX_SINGLETON_ADMISSION_WAIT_MS=90
QDRANT_VEORTEX_SQ8_SPARSE_SCORE_HANDOFF=1
QDRANT_VEORTEX_SQ8_STREAMING_SCORE_STORES=1
QDRANT_VEORTEX_SUPPORT_CPUS=5,6
QDRANT_VEORTEX_SUPPORT_PIPELINE_DEPTH=8
QDRANT_VEORTEX_SUPPORT_SKIP_EMPTY_SPARSE_ROWS=1
QDRANT_VEORTEX_TQ_POINT_ONLY_OWNER_TOPK=1
QDRANT_VEORTEX_TQ_QUERY_BYTES=1
QDRANT__STORAGE__PERFORMANCE__MAX_SEARCH_THREADS=1
RAYON_NUM_THREADS=2
VX_ABLATE=0
VX_PFH=9
VX_SPF=2

# Conservative retained-query reservation cap across this server process.
QDRANT_VEORTEX_MAX_QUEUED_QUERY_BYTES=671088640
