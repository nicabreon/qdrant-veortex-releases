# Experimental ba68b4 executable, VX_PF8=6 control for the two C512 rows.
# Evidence: benchmarks/sq8-prefetch-distance-20261111.json
# All threads share the process CPU allowance. Omit legacy COMPUTE_CPUS/SUPPORT_CPUS.
# Node masks on the measured VM: node0=4,5,6; node1=7,8,9; node2=10,11,12.
# API/peer TLS, credentials, storage paths and collection configuration are separate.
QDRANT_VEORTEX_COALESCE_WINDOW_US=1000
QDRANT_VEORTEX_COOPERATIVE_F32=1
QDRANT_VEORTEX_DENSE_MASKED_SCORE=1
QDRANT_VEORTEX_KERNEL_TIER=auto
QDRANT_VEORTEX_MAX_INFLIGHT_SHARD_SEARCHES=640
QDRANT_VEORTEX_MAX_INFLIGHT_SINGLETON_SEARCHES=640
QDRANT_VEORTEX_MAX_QUEUED_QUERY_BYTES=2147483648
QDRANT_VEORTEX_MAX_RING_WORKERS=3
QDRANT_VEORTEX_PAYLOAD_BYTE_CACHE_BYTES=134217728
QDRANT_VEORTEX_POSTPROCESSING_PLACEMENT=shared
QDRANT_VEORTEX_RAW_PAYLOAD_TRANSPORT=1
QDRANT_VEORTEX_REST_RAW_VALIDATION_CACHE_BYTES=134217728
QDRANT_VEORTEX_RING_FAST_JOIN_CAPACITY=64
QDRANT_VEORTEX_RING_MAX_LANES=96
QDRANT_VEORTEX_SEPARATE_TOPK=1
QDRANT_VEORTEX_SINGLETON_ADMISSION_PERMITS=640
QDRANT_VEORTEX_SINGLETON_ADMISSION_WAIT_MS=90
QDRANT_VEORTEX_SQ8_FUSED_SCORE_PRUNING=0
QDRANT_VEORTEX_SQ8_SPARSE_SCORE_HANDOFF=1
QDRANT_VEORTEX_SQ8_STREAMING_SCORE_STORES=1
QDRANT_VEORTEX_SUPPORT_PIPELINE_DEPTH=8
QDRANT_VEORTEX_SUPPORT_SKIP_EMPTY_SPARSE_ROWS=1
QDRANT_VEORTEX_TQ_POINT_ONLY_OWNER_TOPK=1
QDRANT_VEORTEX_TQ_QUERY_BYTES=1
QDRANT__STORAGE__PERFORMANCE__MAX_SEARCH_THREADS=3
RAYON_NUM_THREADS=3
VX_ABLATE=0
VX_PF8=6
VX_PFH=9
VX_SPF=2
